{
  "name": "vscode-theme-manifest-intellisense",
  "displayName": "SPM Theme Manifest IntelliSense",
  "description": "Provides JSON schema validation and IntelliSense for Site Package Manager theme manifest files.",
  "version": "0.1.0",
  "publisher": "spm",
  "type": "module",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:veneer"
  ],
  "categories": ["Other"],
  "contributes": {
    "languages": [
      {
        "id": "veneer",
        "aliases": ["Veneer Spec", "veneer"],
        "extensions": [".vnr"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "veneer",
        "scopeName": "source.vnr",
        "path": "./syntaxes/veneer.tmLanguage.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/websites/*/*/manifest.json"
        ],
        "url": "./schemas/theme-manifest-schema.json" 
      }
    ]
  },
  "scripts": {
    "build-registry": "node scripts/build-registry.js"
  },
  "dependencies": {
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.2.2"
  }
}
